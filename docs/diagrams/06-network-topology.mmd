    %% NeoBank Digital Leap — Network Topology
    %% Scaffold for MS2. Fill in: CIDR blocks, ports/protocols, HA/DR
    %% topology, NGFW rule sets, and the chosen cloud-to-on-prem link
    %% (VPN / Direct Connect / both). Source of truth is the teacher's
    %% class guidance — keep this diagram aligned with the security
    %% boundary diagram (MS2) and the high-level solution in
    %% 01-high-level-solution.mmd.

    subgraph Internet[Public Internet]
        Clients[Mobile / Web / TPP Clients]
    end

    subgraph CloudVPC[Regional Cloud VPC]
        direction LR
        subgraph CloudPublic[Public Subnets]
            WAF[WAF / DDoS]
        end
        subgraph CloudPrivate[Private Subnets]
            APIGW[API Gateway]
            IAM[Customer IAM]
            BFF[BFF / Digital API]
            AI[AI Financial Advisor]
        end
        subgraph CloudLink[Cloud-to-On-Prem Link]
            VPNTunnel[VPN / Direct Connect\n_TODO: pick one or both_]
        end
    end

    subgraph OnPrem[On-Premises Network]
        direction LR
        subgraph OnPremDMZ[On-Prem DMZ]
            NGFW[NGFW\n_TODO: model inspection, default-deny_]
            EdgeProxy[Reverse Proxy / Controlled API Ingress]
        end
        subgraph OnPremReg[Regulated Zone — Digital Core]
            Core[Core Services\nAccount / Transfer / Consent / Report / Advisor Context]
            FraudRT[Real-Time Fraud Engine]
            EventBus[Durable Event Bus]
            ODS[ODS / Read Models\nEnterprise RDBMS]
            Audit[Audit / Compliance Store]
            OnPremObs[On-Prem Observability]
            CBSGateway[CBS Transaction Gateway\n_Only path to CBS_]
        end
        subgraph OnPremMainframe[Mainframe Zone]
            CBS[COBOL CBS on z/OS]
            DB2[(DB2 Transactions)]
            ADABAS[(ADABAS Customers)]
        end
    end

    %% --- Public ingress (WAF -> API Gateway is non-negotiable) ---
    Clients --> WAF
    WAF --> APIGW
    APIGW --> IAM
    APIGW --> BFF
    BFF --> AI

    %% --- Cloud egress to on-prem (must traverse the link + NGFW) ---
    APIGW --> VPNTunnel
    BFF --> VPNTunnel
    AI --> VPNTunnel
    VPNTunnel --> NGFW
    NGFW --> EdgeProxy

    %% --- DMZ to regulated zone (no direct DMZ access to ODS/EventBus) ---
    EdgeProxy --> Core

    %% --- Regulated zone internal wiring ---
    Core --> ODS
    Core --> EventBus
    Core --> Audit
    Core --> OnPremObs
    Core --> FraudRT
    FraudRT --> Core
    EventBus --> ODS
    EventBus --> Audit

    %% --- Money-moving path: the only route into the mainframe zone ---
    Core --> CBSGateway
    CBSGateway --> CBS
    CBS --> DB2
    CBS --> ADABAS
    CBSGateway --> Audit

