flowchart TD
  INTERNET["Internet / TPP Networks"] --> WAF["Managed WAF + DDoS<br/>Cloud public subnets"]
  WAF --> GW["API Gateway<br/>TLS 443"]
  GW --> CP["Regional Cloud Private Subnets<br/>IAM, BFF, AI Advisor"]
  CP --> LINK["Dual Direct Connect<br/>VPN backup, encrypted BGP"]
  LINK --> NGFW["On-prem NGFW Pair"]
  NGFW --> DMZ["On-prem DMZ<br/>Reverse proxy / ingress"]
  DMZ --> K8S["Digital Core Kubernetes<br/>3 control + 8/14 worker hosts"]
  K8S --> ODS["ODS Cluster<br/>4 primary + 4 warm-DR nodes"]
  K8S --> BUS["Event Bus<br/>5 primary + 5 warm-DR brokers"]
  K8S --> CBSGW["CBS Gateway HA Pair"]
  CBSGW --> MF["Mainframe Zone<br/>z/OS CBS, DB2, ADABAS"]
  K8S --> OBS["Observability Cluster<br/>4 primary + 4 warm-DR nodes"]

