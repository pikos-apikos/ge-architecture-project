flowchart TD
  CBS["CBS / Db2 / ADABAS"] --> CDC["Mainframe CDC"]
  CDC --> MAP["Canonical Mapper"]
  MAP --> BUS["Durable Event Bus"]
  BUS --> PROJ["ODS Projection Service"]
  PROJ --> ODS["Enterprise RDBMS ODS"]
  PROJ --> STATUS["Projection Status Event"]
  ODS --> REC["CBS-led Reconciliation"]
  REC -->|match| READY["Account available"]
  REC -->|mismatch| QUAR["Account-scoped quarantine"]
  QUAR --> REPLAY["Controlled replay / rebuild"]
  REPLAY --> REC

