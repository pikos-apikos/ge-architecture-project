flowchart TD
  ODS["Reconciled ODS Projection"] --> CUT["Month-end Cut-off"]
  CUT --> GEN["Statement Generator"]
  GEN --> SNAP["Immutable Versioned Snapshot"]
  SNAP --> REC["CBS / ODS Reconciliation"]
