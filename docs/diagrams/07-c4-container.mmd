%% NeoBank Digital Leap — C4 Container diagram
%% Mermaid mirror of docs/diagrams/neobank-digital-leap-c4.drawio
%% (after applying the cleanup spec in docs/ms1-presentation-prep.md Part 1).
%% Use C4Container for the Container level. If your Mermaid renderer
%% does not support C4, fall back to the .drawio above.
C4Container
    title Container diagram for NeoBank Digital Leap — MS1

    Person(mobileUser, "Mobile Banking Customer", "Customer using the mobile app")
    Person(webUser, "Web Banking Customer", "Customer using the web app")
    System_Ext(tpps, "Open Banking TPPs", "Third-party providers consuming Open Banking APIs")

    System_Boundary(c1, "NeoBank Digital Leap") {

        %% Cloud provider labels are candidates pending OI-001 (provider/region
        %% approval); AWS is shown as the working candidate given team skills.
        System_Boundary(cloud, "Regional Cloud Environment") {
            Container(waf, "WAF / DDoS", "AWS WAF (candidate)", "Public traffic protection")
            Container(apigw, "API Gateway", "AWS API Gateway (candidate)", "Public entry point, routing, throttling")
            Container(iam, "Customer IAM", "AWS Cognito (candidate)", "OAuth2 / OIDC / MFA")
            Container(bff, "BFF / Digital API", "Quarkus", "Client-oriented API layer")
            Container(aiAdvisor, "AI Financial Advisor", "Quarkus", "Cloud-only advice orchestration; no direct CBS/ODS access")
            Container(cloudObs, "Cloud Observability", "AWS CloudWatch + X-Ray (candidate)", "Metrics, logs, traces")
        }

        System_Boundary(onPrem, "New On-Premises Digital Core") {
            Container(accountSvc, "Account Information Service", "Quarkus", "Serves account & balance from read models")
            Container(consentSvc, "Open Banking Consent Service", "Quarkus", "Customer consent and access boundaries for TPPs")
            Container(reportSvc, "Income / Expense Report Service", "Quarkus", "Monthly income/expense report")
            Container(transferSvc, "Transfer Service", "Quarkus", "Orchestrates transfers through CBS")
            Container(fraudRT, "Real-Time Fraud Engine", "Quarkus", "Synchronous fraud check on transfers")
            Container(fraudOffline, "Offline Fraud Analytics", "Quarkus", "Batch risk scoring, model tuning")
            Container(advisorContext, "Advisor Context API", "Quarkus", "Authorizes and minimizes customer context for AI advice")
            Container(cbsGw, "CBS Transaction Gateway", "Quarkus", "Only path to CBS; idempotency, audit")
            Container(db2Adapter, "DB2 Adapter", "Quarkus", "Publishes DB2 changes to event bus")
            Container(adabasAdapter, "ADABAS Adapter", "Quarkus", "Publishes ADABAS changes to event bus")
            ContainerQueue(eventBus, "Durable Event Bus", "Apache Kafka", "Backbone for projections, audit, analytics")
            Container(audit, "Audit / Compliance Store", "Append-only log", "Immutable audit trail")
            Container(onPremObs, "On-Prem Observability", "Prometheus + Loki + Tempo", "Metrics, logs, traces")
            ContainerDb(ods, "Read Models / ODS", "Enterprise RDBMS — Oracle / SQL Server / Db2 (MS2 decision, ADR-002)", "Read-optimized projections")
        }

        System_Boundary(legacy, "Existing Legacy Core") {
            ContainerDb(cbs, "CBS", "COBOL on z/OS / IBM iSeries", "System of record for transactions")
            ContainerDb(db2, "DB2 Transactions", "IBM DB2", "System of record for transactions")
            ContainerDb(adabas, "ADABAS Customers", "ADABAS", "System of record for customer information")
        }
    }

    %% --- Public ingress (WAF -> API Gateway is non-negotiable) ---
    Rel(mobileUser, waf, "Uses mobile app", "HTTPS")
    Rel(webUser, waf, "Uses web app", "HTTPS")
    Rel(tpps, waf, "Consumes Open Banking APIs / consent flows", "HTTPS")
    Rel(waf, apigw, "Forwards", "HTTPS")
    Rel(apigw, iam, "Authenticates", "OAuth2 / OIDC")
    Rel(apigw, bff, "Routes", "HTTPS")

    %% --- Cloud internal ---
    Rel(bff, aiAdvisor, "Requests advice", "HTTPS")
    Rel(bff, accountSvc, "Calls", "mTLS")
    Rel(bff, consentSvc, "Manages consent / Open Banking access", "mTLS")
    Rel(bff, reportSvc, "Calls", "mTLS")
    Rel(bff, transferSvc, "Calls", "mTLS")
    Rel(bff, cloudObs, "Emits telemetry", "OTel")

    %% --- AI data-minimization boundary ---
    Rel(aiAdvisor, advisorContext, "Requests minimized context", "mTLS")
    Rel(advisorContext, consentSvc, "Checks authorization scope", "mTLS")
    Rel(advisorContext, ods, "Reads authorized projections", "SQL")

    %% --- Transfer command path (only path to the mainframe) ---
    Rel(transferSvc, fraudRT, "Validates", "mTLS")
    Rel(fraudRT, transferSvc, "Approve / reject", "mTLS")
    Rel(transferSvc, cbsGw, "Executes via", "mTLS")
    Rel(cbsGw, cbs, "Calls", "Mainframe protocol")
    Rel(cbs, db2, "Reads / writes", "internal")
    Rel(cbs, adabas, "Reads / writes", "internal")

    %% --- Data ingestion (CDC from mainframe) ---
    Rel(db2, db2Adapter, "CDC", "internal")
    Rel(adabas, adabasAdapter, "CDC", "internal")
    Rel(db2Adapter, eventBus, "Publishes", "Kafka")
    Rel(adabasAdapter, eventBus, "Publishes", "Kafka")

    %% --- Event bus consumers ---
    Rel(eventBus, ods, "Projects", "Kafka consumer")
    Rel(eventBus, fraudOffline, "Feeds", "Kafka consumer")
    Rel(eventBus, audit, "Writes", "Kafka consumer")

    %% --- Read paths (CQRS: reads go to ODS, not CBS) ---
    Rel(accountSvc, ods, "Reads", "SQL")
    Rel(reportSvc, ods, "Reads", "SQL")
    Rel(consentSvc, ods, "Reads", "SQL")
    Rel(fraudOffline, ods, "Reads", "SQL")
    Rel(fraudOffline, fraudRT, "Publishes rules", "internal")

    %% --- Audit (append-only, money-moving and fraud decisions) ---
    Rel(transferSvc, audit, "Writes", "append-only")
    Rel(cbsGw, audit, "Writes", "append-only")
    Rel(fraudRT, audit, "Writes", "append-only")
    Rel(advisorContext, audit, "Records data-minimization decisions", "append-only")

    %% --- Observability ---
    Rel(accountSvc, onPremObs, "Emits", "OTel")
    Rel(transferSvc, onPremObs, "Emits", "OTel")
    Rel(cbsGw, onPremObs, "Emits", "OTel")
    Rel(fraudRT, onPremObs, "Emits", "OTel")
    Rel(advisorContext, onPremObs, "Emits", "OTel")
    Rel(onPremObs, cloudObs, "Ships", "mTLS")

    %% --- Architectural invariants (visual emphasis) ---
    UpdateRelStyle(aiAdvisor, advisorContext, $textColor="#c00", $offsetY="-30")
    UpdateElementStyle(cbsGw, $bgColor="#fdd", $borderColor="#c00")
    UpdateElementStyle(cbs, $bgColor="#fdd", $borderColor="#c00")
    UpdateElementStyle(aiAdvisor, $bgColor="#ffd", $borderColor="#c80")
    UpdateElementStyle(advisorContext, $bgColor="#ffd", $borderColor="#c80")
